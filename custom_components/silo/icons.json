{
  "services": {
    "play": {
      "service": "mdi:play-box"
    },
    "shuffle": {
      "service": "mdi:shuffle-variant"
    },
    "run_task": {
      "service": "mdi:cog-play"
    },
    "send_message": {
      "service": "mdi:message-text"
    },
    "stop_playback": {
      "service": "mdi:stop-circle"
    }
  },
  "entity": {
    "sensor": {
      "movies": {
        "default": "mdi:movie-open"
      },
      "shows": {
        "default": "mdi:television-classic"
      },
      "episodes": {
        "default": "mdi:filmstrip-box-multiple"
      },
      "titles": {
        "default": "mdi:library-shelves"
      },
      "requests_pending": {
        "default": "mdi:inbox-arrow-down"
      },
      "requests_failed": {
        "default": "mdi:alert-circle-outline"
      },
      "running_tasks": {
        "default": "mdi:progress-clock"
      },
      "last_library_scan": {
        "default": "mdi:folder-search"
      },
      "active_streams": {
        "default": "mdi:play-network"
      },
      "transcodes": {
        "default": "mdi:swap-horizontal-bold"
      },
      "profile_activity": {
        "default": "mdi:account-eye",
        "state": {
          "idle": "mdi:account",
          "playing": "mdi:play-circle",
          "paused": "mdi:pause-circle"
        }
      }
    },
    "button": {
      "scan_all": {
        "default": "mdi:folder-refresh"
      },
      "refresh_metadata": {
        "default": "mdi:database-refresh"
      },
      "scan_library": {
        "default": "mdi:folder-search"
      }
    }
  }
}
